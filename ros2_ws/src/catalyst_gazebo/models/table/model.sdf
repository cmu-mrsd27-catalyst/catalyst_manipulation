<?xml version="1.0"?>
<!--
  Work Table Model for Catalyst Manipulator Simulation
  ====================================================

  A table with a flat top and 4 cylindrical legs.

  TO MODIFY DIMENSIONS:
  1. Table top: Change <size> in table_top collision/visual
  2. Leg height: Change <length> in leg cylinders AND <pose> z-offset
  3. Leg radius: Change <radius> in leg cylinders
  4. Leg positions: Change <pose> x,y values for each leg

  DIMENSION REFERENCE (defaults):
  - Table top: 0.80m x 0.60m x 0.03m (X x Y x Z)
  - Legs: radius=0.03m, height=0.77m (so total height = 0.80m)
  - Leg offset from edge: 0.05m inward

  MODEL ORIGIN: Center of table top surface (not the geometric center)
  This makes it easier to position - just set Z to desired table height.
-->
<sdf version="1.6">
  <model name="work_table">
    <static>true</static>

    <!-- ==================== TABLE TOP ==================== -->
    <link name="table_top">
      <pose>0 0 -0.015 0 0 0</pose>  <!-- Offset down by half thickness -->

      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.31</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.54</iyy><iyz>0</iyz>
          <izz>0.83</izz>
        </inertia>
      </inertial>

      <collision name="top_collision">
        <geometry>
          <box>
            <!-- TABLE TOP DIMENSIONS: X(width) Y(depth) Z(thickness) -->
            <size>0.80 0.60 0.03</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="top_visual">
        <geometry>
          <box>
            <size>0.80 0.60 0.03</size>
          </box>
        </geometry>
        <material>
          <!-- Wood-like brown color -->
          <ambient>0.6 0.4 0.2 1</ambient>
          <diffuse>0.6 0.4 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- ==================== TABLE LEGS ==================== -->
    <!--
      Leg positions (looking down at table, robot at -X):

        (-X,+Y) LEG 1 -------- LEG 2 (+X,+Y)
                  |            |
                  |   TABLE    |
                  |            |
        (-X,-Y) LEG 3 -------- LEG 4 (+X,-Y)

      Leg center offset from edge: 0.05m
      So for 0.80 x 0.60 table:
        X offset = 0.80/2 - 0.05 = 0.35
        Y offset = 0.60/2 - 0.05 = 0.25
    -->

    <!-- LEG 1: Front-Left (-X, +Y) -->
    <link name="leg_1">
      <!-- Pose: x, y, z(center of leg), roll, pitch, yaw -->
      <!-- Z = -(table_top_thickness + leg_height/2) = -(0.03 + 0.77/2) = -0.415 -->
      <pose>-0.35 0.25 -0.415 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.05</iyy><iyz>0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>

      <collision name="leg_1_collision">
        <geometry>
          <cylinder>
            <!-- LEG DIMENSIONS -->
            <radius>0.03</radius>
            <length>0.77</length>  <!-- Height = total_height - top_thickness -->
          </cylinder>
        </geometry>
      </collision>

      <visual name="leg_1_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.77</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.35 0.15 1</ambient>
          <diffuse>0.5 0.35 0.15 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- LEG 2: Front-Right (+X, +Y) -->
    <link name="leg_2">
      <pose>0.35 0.25 -0.415 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.05</iyy><iyz>0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>

      <collision name="leg_2_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.77</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="leg_2_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.77</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.35 0.15 1</ambient>
          <diffuse>0.5 0.35 0.15 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- LEG 3: Back-Left (-X, -Y) -->
    <link name="leg_3">
      <pose>-0.35 -0.25 -0.415 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.05</iyy><iyz>0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>

      <collision name="leg_3_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.77</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="leg_3_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.77</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.35 0.15 1</ambient>
          <diffuse>0.5 0.35 0.15 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- LEG 4: Back-Right (+X, -Y) -->
    <link name="leg_4">
      <pose>0.35 -0.25 -0.415 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.05</iyy><iyz>0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>

      <collision name="leg_4_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.77</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="leg_4_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.77</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.35 0.15 1</ambient>
          <diffuse>0.5 0.35 0.15 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- Fixed joints to connect legs to table top -->
    <joint name="leg_1_joint" type="fixed">
      <parent>table_top</parent>
      <child>leg_1</child>
    </joint>
    <joint name="leg_2_joint" type="fixed">
      <parent>table_top</parent>
      <child>leg_2</child>
    </joint>
    <joint name="leg_3_joint" type="fixed">
      <parent>table_top</parent>
      <child>leg_3</child>
    </joint>
    <joint name="leg_4_joint" type="fixed">
      <parent>table_top</parent>
      <child>leg_4</child>
    </joint>

  </model>
</sdf>
