<?xml version="1.0"?>
<!--
  Robot Stand Model for Catalyst Manipulator
  ==========================================

  A vertical cuboid stand for mounting the robot.

  TO MODIFY DIMENSIONS:
  1. Change the <size> values in both <collision> and <visual> geometry
  2. Ensure both have the same values for accurate physics

  Default: 0.5m x 0.5m x 0.8m (X x Y x Z)

  The stand is centered at origin. When placing in world:
  - Set Z position to half the height so bottom touches ground
  - Robot should be spawned at Z = stand_height
-->
<sdf version="1.6">
  <model name="robot_stand">
    <static>true</static>

    <link name="stand_link">
      <!-- Inertial properties (not used for static model, but good practice) -->
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>4.17</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17</iyy>
          <iyz>0</iyz>
          <izz>2.08</izz>
        </inertia>
      </inertial>

      <!-- Collision geometry -->
      <collision name="stand_collision">
        <geometry>
          <box>
            <!-- MODIFY THESE VALUES TO CHANGE STAND SIZE -->
            <size>0.50 0.50 0.80</size>  <!-- X Y Z in meters -->
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Visual geometry -->
      <visual name="stand_visual">
        <geometry>
          <box>
            <!-- MUST MATCH COLLISION SIZE -->
            <size>0.50 0.50 0.80</size>  <!-- X Y Z in meters -->
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
