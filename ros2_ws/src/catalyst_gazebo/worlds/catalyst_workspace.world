<?xml version="1.0"?>
<!--
  Catalyst Manipulator Workspace World
  =====================================

  A simulation environment with:
  - Robot stand (0.5m x 0.5m x 0.8m cuboid)
  - Work table (0.8m x 0.6m, same height as stand)
  - Ground plane
  - Lighting

  HOW TO MODIFY:
  ==============

  1. CHANGE STAND POSITION:
     Find <model name="robot_stand"> and modify <pose>
     Format: <pose>X Y Z Roll Pitch Yaw</pose>

  2. CHANGE TABLE POSITION:
     Find <model name="work_table"> and modify <pose>
     The table's Z should be set to the desired table top height

  3. ADD NEW OBJECTS:
     Copy an <include> block and modify:
     - <name>: Unique name for the object
     - <uri>: Path to model (model://model_name or file://path)
     - <pose>: Position and orientation

  4. CHANGE LIGHTING:
     Modify the <light> elements at the bottom

  5. USE CUSTOM MODELS:
     Place your model folder in catalyst_gazebo/models/
     Reference it with: <uri>model://your_model_name</uri>

  COORDINATE REFERENCE:
  ====================
  - Robot stand center: (0, 0, 0.4)
  - Robot base (link_base): (0, 0, 0.8)  <- Top of stand
  - Table center: (0.55, 0, 0.8)         <- In front of robot

  Note: The robot is NOT spawned from this world file.
  It's spawned separately via the launch file for ros2_control integration.
-->
<sdf version="1.6">
  <world name="catalyst_workspace">

    <!-- ==================== PHYSICS ==================== -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
    </physics>

    <!-- ==================== SCENE ==================== -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ==================== GROUND PLANE ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== ROBOT STAND ==================== -->
    <!--
      Position: Center of stand at (0, 0, 0.4)
      This places the bottom at Z=0 and top at Z=0.8

      TO MODIFY:
      - Change X,Y to move stand horizontally
      - Change Z to: desired_top_height - (stand_height/2)
    -->
    <include>
      <name>robot_stand</name>
      <uri>model://robot_stand</uri>
      <!-- X    Y    Z    Roll Pitch Yaw -->
      <pose>0.0  0.0  0.4  0    0     0</pose>
    </include>

    <!-- ==================== WORK TABLE ==================== -->
    <!--
      Position: Table top surface at Z=0.8 (same as robot base)
      Table is placed in front of robot (+X direction)

      Gap calculation:
      - Stand edge: 0 + 0.5/2 = 0.25 (stand center + half width)
      - Gap: 0.05m
      - Table edge: table_center - table_depth/2
      - So: table_center = 0.25 + 0.05 + 0.6/2 = 0.55

      TO MODIFY:
      - Change X to adjust distance from robot
      - Change Y to shift table left/right
      - Z should match desired table top height
    -->
    <include>
      <name>work_table</name>
      <uri>model://table</uri>
      <!-- X     Y    Z    Roll Pitch Yaw -->
      <pose>0.55  0.0  0.8  0    0     0</pose>
    </include>

    <!-- ==================== LIGHTING ==================== -->

    <!-- Main directional light (sun) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Fill light from front -->
    <light name="fill_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>2 0 3 0 0 0</pose>
      <diffuse>0.3 0.3 0.3 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>-1 0 -0.5</direction>
    </light>

    <!-- Point light above workspace -->
    <light name="workspace_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>0.3 0 2.0 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>5</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

  </world>
</sdf>
