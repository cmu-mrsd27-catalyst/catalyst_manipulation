<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="bio_gazebo_grasp_fix" params="prefix:='' arm_name:='bio_gripper' palm_link:='link_base'">
    <!-- Disabled by default: requires external libgazebo_grasp_fix.so -->
    <!--
