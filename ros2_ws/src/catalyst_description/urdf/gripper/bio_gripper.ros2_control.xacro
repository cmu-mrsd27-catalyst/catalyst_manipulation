<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="bio_gripper_ros2_control" params="prefix:=''
    ros2_control_plugin:='uf_robot_hardware/UFRobotFakeSystemHardware' ">
    <ros2_control name="${prefix}BioGripperSystem" type="system">
      <hardware>
        <plugin>${ros2_control_plugin}</plugin>
      </hardware>
      <joint name="${prefix}right_finger_joint">
        <command_interface name="position">
          <param name="initial_value">0.04</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-3.14</param>
          <param name="max">3.14</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.04</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}left_finger_joint">
        <param name="mimic">${prefix}right_finger_joint</param>
        <param name="multiplier">-1</param>
        <state_interface name="position">
          <param name="initial_value">-0.04</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
