<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="catalyst_manipulator">

  <!--
    Catalyst Manipulator - Top-Level URDF
    ======================================
    Composes:
      1. xArm-6 (from upstream xarm_description)
      2. Bio gripper copy (from this package)
      3. Gazebo plugins (optional, for simulation)

    ARGUMENTS:
      - use_gazebo: Set to "true" to include Gazebo-specific plugins
      - ros2_control_plugin: Hardware plugin
        - For fake: uf_robot_hardware/UFRobotFakeSystemHardware
        - For Gazebo: gz_ros2_control/GazeboSimSystem
        - For real: uf_robot_hardware/UFRobotSystemHardware
  -->

  <!-- ========== Arguments ========== -->
  <xacro:arg name="prefix"    default=""/>
  <xacro:arg name="hw_ns"     default="xarm"/>
  <xacro:arg name="robot_ip"  default="192.168.1.212"/>
  <xacro:arg name="robot_sn"  default=""/>
  <xacro:arg name="limited"   default="false"/>
  <xacro:arg name="velocity_control" default="false"/>
  <xacro:arg name="ros2_control_plugin"
             default="uf_robot_hardware/UFRobotFakeSystemHardware"/>
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="add_gripper" default="true"/>
  <xacro:arg name="add_gripper_ros2_control" default="true"/>
  <xacro:arg name="add_ft_sensor" default="false"/>
  <xacro:arg name="ft_sensor_ip" default="192.168.2.1"/>

  <!-- Property for conditional checks -->
  <xacro:property name="use_gazebo" value="$(arg use_gazebo)"/>
  <xacro:property name="add_gripper_val" value="$(arg add_gripper)"/>
  <xacro:property name="add_gripper_ros2_control_val" value="$(arg add_gripper_ros2_control)"/>
  <xacro:property name="add_ft_sensor_val" value="$(arg add_ft_sensor)"/>


  <!-- ========== Include upstream xArm device macro ========== -->
  <xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro"/>

  <!-- ========== Include our local bio gripper ========== -->
  <xacro:include filename="$(find catalyst_description)/urdf/gripper/bio_gripper.urdf.xacro"/>
  <xacro:include filename="$(find catalyst_description)/urdf/gripper/bio_gripper.ros2_control.xacro"/>

  <!-- ========== Gazebo-specific includes (conditional) ========== -->
  <xacro:include filename="$(find catalyst_description)/urdf/gripper/bio_gripper.gazebo.xacro"/>
  <xacro:include filename="$(find catalyst_description)/urdf/gazebo/gazebo_ros2_control.xacro"/>


  <!-- ========== Instantiate xArm-6 (no stock gripper) ========== -->
  <xacro:xarm_device
    dof="6"
    robot_type="xarm"
    prefix="$(arg prefix)"
    hw_ns="$(arg hw_ns)"
    limited="$(arg limited)"
    velocity_control="$(arg velocity_control)"
    ros2_control_plugin="$(arg ros2_control_plugin)"
    robot_ip="$(arg robot_ip)"
    robot_sn="$(arg robot_sn)"
    add_gripper="false"
    add_vacuum_gripper="false"
    add_bio_gripper="false"
  />


  <!-- ========== F/T Sensor cylindrical link between flange and gripper ========== -->
  <!--
    Physical OnRobot F/T sensor body: 68mm diameter x 68mm height cylinder.
    Sits between link_eef (flange) and the bio gripper.
  -->
  <link name="$(arg prefix)ft_sensor_link">
    <visual>
      <origin xyz="0 0 0.034" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.068"/>
      </geometry>
      <material name="DarkGrey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.034" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.068"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.034" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="$(arg prefix)ft_sensor_joint" type="fixed">
    <parent link="$(arg prefix)link_eef"/>
    <child link="$(arg prefix)ft_sensor_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- ========== Attach our bio gripper to the arm ========== -->
  <!--
    The xarm6 kinematic chain ends at:
      link6 -> (fixed joint_eef) -> link_eef -> (fixed ft_sensor_joint) -> ft_sensor_link

    The bio_gripper attaches to the top of the F/T sensor cylinder (offset 0.068m in Z).
  -->
  <xacro:if value="${add_gripper_val}">
    <xacro:bio_gripper_urdf
      prefix="$(arg prefix)"
      attach_to="$(arg prefix)ft_sensor_link"
      attach_xyz="0.039 0 0.107"
      attach_rpy="0 -1.5708 0"
    />

    <!-- ========== Add ros2_control interfaces for the gripper (conditional) ========== -->
    <!-- Skipped in real mode: the Dynamixel gripper is controlled independently -->
    <xacro:if value="${add_gripper_ros2_control_val}">
      <xacro:bio_gripper_ros2_control
        prefix="$(arg prefix)"
        ros2_control_plugin="$(arg ros2_control_plugin)"
      />
    </xacro:if>
  </xacro:if>


  <!-- ========== OnRobot F/T sensor (real hardware only) ========== -->
  <!--
    Adds the net_ft_driver ros2_control sensor interface so the existing
    controller_manager can load force_torque_sensor_broadcaster.
    The sensor sits physically between link_eef and the gripper.
  -->
  <xacro:if value="${add_ft_sensor_val}">
    <xacro:include filename="$(find net_ft_description)/urdf/net_ft_sensor.ros2_control.xacro"/>
    <xacro:net_ft_sensor_ros2_control
      name="NetFtHardwareInterface"
      sensor_type="onrobot"
      ip_address="$(arg ft_sensor_ip)"
      rdt_sampling_rate="500"
      internal_filter_rate="0"
      use_hardware_biasing="true"/>
  </xacro:if>

  <!-- ========== Gazebo-specific Configuration ========== -->
  <!--
    When use_gazebo:=true, this adds:
    1. gz_ros2_control plugin (bridges Gz physics with ros2_control)
    2. Collision settings for gripper links
    3. Grasp fix plugin (still disabled/commented out)

    NOTE: Mimic joint handling is done via gz_ros2_control (see bio_gripper.ros2_control.xacro)
          so no separate mimic joint plugin is needed.
  -->
  <xacro:if value="${use_gazebo}">
    <!-- Gazebo ros2_control plugin -->
    <xacro:gazebo_ros2_control_plugin
      ros2_control_params="$(find catalyst_bringup)/config/ros2_controllers.yaml"
    />

    <!-- Gripper Gazebo settings (collision, etc.) -->
    <xacro:if value="${add_gripper_val}">
      <xacro:bio_gripper_gazebo prefix="$(arg prefix)"/>

      <!-- Grasp fix plugin for realistic grasping -->
      <xacro:bio_gazebo_grasp_fix
        prefix="$(arg prefix)"
        arm_name="bio_gripper"
        palm_link="$(arg prefix)bio_gripper_base_link"
      />
    </xacro:if>
  </xacro:if>

</robot>
