<?xml version="1.0" encoding="UTF-8"?>
<!--
  Catalyst Manipulator - Semantic Robot Description Format (SRDF)
  ================================================================
  Defines:
    - Planning groups (arm, gripper, manipulator)
    - End effector configuration
    - Virtual joint to world
    - Disabled collision pairs
-->
<robot name="catalyst_manipulator">

  <!-- ========== Virtual Joint ========== -->
  <!-- Connects robot base to world frame for motion planning -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="link_base"/>

  <!-- ========== Planning Groups ========== -->

  <!-- Arm group: xArm-6 joints (6-DOF) -->
  <group name="arm">
    <chain base_link="link_base" tip_link="link_eef"/>
  </group>

  <!-- Gripper group: Bio gripper finger joints -->
  <group name="gripper">
    <joint name="right_finger_joint"/>
    <joint name="left_finger_joint"/>
  </group>

  <!-- Manipulator group: Full chain from base to tool center point -->
  <group name="manipulator">
    <chain base_link="link_base" tip_link="link_tcp"/>
  </group>

  <!-- ========== Group States (Named Poses) ========== -->

  <!-- Arm home position (all joints at zero) -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <!-- Arm ready position (typical start pose) -->
  <group_state name="ready" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="-0.785"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0.785"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <!-- Gripper open position -->
  <group_state name="open" group="gripper">
    <joint name="right_finger_joint" value="0.04"/>
    <joint name="left_finger_joint" value="-0.04"/>
  </group_state>

  <!-- Gripper closed position -->
  <group_state name="closed" group="gripper">
    <joint name="right_finger_joint" value="0"/>
    <joint name="left_finger_joint" value="0"/>
  </group_state>

  <!-- ========== End Effector ========== -->
  <end_effector name="bio_gripper" parent_link="link_eef" group="gripper" parent_group="arm"/>

  <!-- ========== Passive Joints ========== -->
  <!-- Left finger mimics right finger, so mark it as passive for planning -->
  <passive_joint name="left_finger_joint"/>

  <!-- ========== Disabled Collisions ========== -->
  <!-- Adjacent links in kinematic chain (always in collision or never can collide) -->

  <!-- Virtual joint to base -->
  <disable_collisions link1="link_base" link2="link1" reason="Adjacent"/>

  <!-- Arm chain: adjacent links -->
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="link_eef" reason="Adjacent"/>

  <!-- End effector to gripper base -->
  <disable_collisions link1="link_eef" link2="bio_gripper_base_link" reason="Adjacent"/>

  <!-- Gripper internal: base to fingers -->
  <disable_collisions link1="bio_gripper_base_link" link2="bio_gripper_left_finger" reason="Adjacent"/>
  <disable_collisions link1="bio_gripper_base_link" link2="bio_gripper_right_finger" reason="Adjacent"/>

  <!-- Gripper internal: TCP link -->
  <disable_collisions link1="bio_gripper_base_link" link2="link_tcp" reason="Adjacent"/>

  <!-- Links that can never collide due to distance -->
  <disable_collisions link1="link_base" link2="link2" reason="Never"/>
  <disable_collisions link1="link_base" link2="link3" reason="Never"/>
  <disable_collisions link1="link1" link2="link3" reason="Never"/>
  <disable_collisions link1="link1" link2="link4" reason="Never"/>
  <disable_collisions link1="link2" link2="link4" reason="Never"/>
  <disable_collisions link1="link2" link2="link5" reason="Never"/>
  <disable_collisions link1="link3" link2="link5" reason="Never"/>
  <disable_collisions link1="link3" link2="link6" reason="Never"/>
  <disable_collisions link1="link4" link2="link6" reason="Never"/>
  <disable_collisions link1="link4" link2="link_eef" reason="Never"/>
  <disable_collisions link1="link5" link2="link_eef" reason="Never"/>

  <!-- Gripper links to nearby arm links -->
  <disable_collisions link1="link6" link2="bio_gripper_base_link" reason="Never"/>
  <disable_collisions link1="link_eef" link2="bio_gripper_left_finger" reason="Never"/>
  <disable_collisions link1="link_eef" link2="bio_gripper_right_finger" reason="Never"/>
  <disable_collisions link1="link_eef" link2="link_tcp" reason="Never"/>

  <!-- Finger to TCP (no collision needed) -->
  <disable_collisions link1="bio_gripper_left_finger" link2="link_tcp" reason="Never"/>
  <disable_collisions link1="bio_gripper_right_finger" link2="link_tcp" reason="Never"/>

</robot>
