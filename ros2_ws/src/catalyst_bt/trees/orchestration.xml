<root BTCPP_format="4" main_tree_to_execute="MainPickOnly">

  <!--
    Task trees are selected at runtime via /bt_execute (JsonCommand).
    Explore runs once per service call; tag_pose comes from explore result (blackboard explore_result).

    *WithDetect* trees insert /detect_well_plate after Explore (GPU server + detect_well_plate_action_server).

    MainDemoOrchestration: machine pick (vision pick_safe) → place_on_robot → home → re-explore +
    vision place_safe → pick_from_robot_container → place on machine → home.

    MainPickContainerThenPlaceOnRobot: pick_from_robot_container (retract, MoveIt, down_right, home
    with plate) then place_on_robot (down_right → pre_place, SDK admittance, release, restart, home).

    Octomap on/clear: owned by pick/place action servers only (not in InitMinimal).
  -->

  <!-- ========== Init: home only ========== -->
  <BehaviorTree ID="InitMinimal">
    <Sequence name="init_minimal">
      <JsonService name="Home"
        service_name="/joint_command"
        command='{"pose": "home", "speed": 0.3}'/>
    </Sequence>
  </BehaviorTree>

  <!-- ========== pick_only ========== -->
  <BehaviorTree ID="MainPickOnly">
    <ReactiveSequence name="safe_pick_only">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <TaskAction name="Explore"
          action_name="/explore"
          command='{"tag_frame": "tag_liquid_handler"}'
          result="{explore_result}"
          timeout_sec="120"/>
        <TaskAction name="Pick"
          action_name="/pick"
          command='{"use_guide_mode": true}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <JsonService name="HomeEnd"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- ========== pick_only with well-plate vision (GPU server) ========== -->
  <BehaviorTree ID="MainPickOnlyWithDetect">
    <ReactiveSequence name="safe_pick_only_with_detect">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <TaskAction name="Explore"
          action_name="/explore"
          command='{"tag_frame": "tag_liquid_handler"}'
          result="{explore_result}"
          timeout_sec="120"/>
        <TaskAction name="DetectWellPlate"
          action_name="/detect_well_plate"
          command='{"require":"pick_safe"}'
          overrides="{explore_result}"
          timeout_sec="180"/>
        <TaskAction name="Pick"
          action_name="/pick"
          command='{"use_guide_mode": true}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <JsonService name="HomeEnd"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- ========== place_only ========== -->
  <BehaviorTree ID="MainPlaceOnly">
    <ReactiveSequence name="safe_place_only">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <TaskAction name="Explore"
          action_name="/explore"
          command='{"tag_frame": "tag_liquid_handler"}'
          result="{explore_result}"
          timeout_sec="120"/>
        <TaskAction name="Place"
          action_name="/place"
          command='{}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <JsonService name="HomeEnd"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- ========== place_only with well-plate vision ========== -->
  <BehaviorTree ID="MainPlaceOnlyWithDetect">
    <ReactiveSequence name="safe_place_only_with_detect">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <TaskAction name="Explore"
          action_name="/explore"
          command='{"tag_frame": "tag_liquid_handler"}'
          result="{explore_result}"
          timeout_sec="120"/>
        <TaskAction name="DetectWellPlate"
          action_name="/detect_well_plate"
          command='{"require":"place_safe"}'
          overrides="{explore_result}"
          timeout_sec="180"/>
        <TaskAction name="Place"
          action_name="/place"
          command='{}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <JsonService name="HomeEnd"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- ========== pick_place (one explore, pick then place, then home) ========== -->
  <BehaviorTree ID="MainPickPlace">
    <ReactiveSequence name="safe_pick_place">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <TaskAction name="Explore"
          action_name="/explore"
          command='{"tag_frame": "tag_liquid_handler"}'
          result="{explore_result}"
          timeout_sec="120"/>
        <TaskAction name="Pick"
          action_name="/pick"
          command='{"use_guide_mode": true}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <TaskAction name="Place"
          action_name="/place"
          command='{}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <JsonService name="HomeEnd"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- ========== pick_place with single vision check (both stands) ========== -->
  <BehaviorTree ID="MainPickPlaceWithDetect">
    <ReactiveSequence name="safe_pick_place_with_detect">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <TaskAction name="Explore"
          action_name="/explore"
          command='{"tag_frame": "tag_liquid_handler"}'
          result="{explore_result}"
          timeout_sec="120"/>
        <TaskAction name="DetectWellPlate"
          action_name="/detect_well_plate"
          command='{"require":"both"}'
          overrides="{explore_result}"
          timeout_sec="180"/>
        <TaskAction name="Pick"
          action_name="/pick"
          command='{"use_guide_mode": true}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <TaskAction name="Place"
          action_name="/place"
          command='{}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <JsonService name="HomeEnd"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- ========== place_pick (one explore, place then pick, then home) ========== -->
  <BehaviorTree ID="MainPlacePick">
    <ReactiveSequence name="safe_place_pick">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <TaskAction name="Explore"
          action_name="/explore"
          command='{"tag_frame": "tag_liquid_handler"}'
          result="{explore_result}"
          timeout_sec="120"/>
        <TaskAction name="Place"
          action_name="/place"
          command='{}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <TaskAction name="Pick"
          action_name="/pick"
          command='{"use_guide_mode": true}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <JsonService name="HomeEnd"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- ========== place_pick with vision (both stands before place) ========== -->
  <BehaviorTree ID="MainPlacePickWithDetect">
    <ReactiveSequence name="safe_place_pick_with_detect">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <TaskAction name="Explore"
          action_name="/explore"
          command='{"tag_frame": "tag_liquid_handler"}'
          result="{explore_result}"
          timeout_sec="120"/>
        <TaskAction name="DetectWellPlate"
          action_name="/detect_well_plate"
          command='{"require":"both"}'
          overrides="{explore_result}"
          timeout_sec="180"/>
        <TaskAction name="Place"
          action_name="/place"
          command='{}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <TaskAction name="Pick"
          action_name="/pick"
          command='{"use_guide_mode": true}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <JsonService name="HomeEnd"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- ========== pick then place well plate on robot-side container ========== -->
  <BehaviorTree ID="MainPickThenPlaceOnRobot">
    <ReactiveSequence name="safe_pick_then_place_on_robot">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <TaskAction name="Explore"
          action_name="/explore"
          command='{"tag_frame": "tag_liquid_handler"}'
          result="{explore_result}"
          timeout_sec="120"/>
        <TaskAction name="Pick"
          action_name="/pick"
          command='{"use_guide_mode": true}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <JsonService name="HomeAfterPick"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
        <TaskAction name="PlaceOnRobot"
          action_name="/place_on_robot"
          command='{}'
          timeout_sec="400"/>
        <JsonService name="HomeEnd"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- ========== demo: machine → robot container → home → container → machine ========== -->
  <BehaviorTree ID="MainDemoOrchestration">
    <ReactiveSequence name="safe_demo_orchestration">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <!-- Phase 1: pick from workpiece, place on robot container -->
        <TaskAction name="Explore1"
          action_name="/explore"
          command='{"tag_frame": "tag_liquid_handler"}'
          result="{explore_result}"
          timeout_sec="120"/>
        <TaskAction name="Detect1"
          action_name="/detect_well_plate"
          command='{"require":"pick_safe"}'
          overrides="{explore_result}"
          timeout_sec="180"/>
        <TaskAction name="PickMachine"
          action_name="/pick"
          command='{"use_guide_mode": true}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <JsonService name="HomeAfterPick"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
        <TaskAction name="PlaceOnRobot"
          action_name="/place_on_robot"
          command='{}'
          timeout_sec="400"/>
        <JsonService name="HomeBeforeReturn"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
        <!-- Phase 2: fresh tag + place_safe, then return plate to machine -->
        <TaskAction name="Explore2"
          action_name="/explore"
          command='{"tag_frame": "tag_liquid_handler"}'
          result="{explore_result}"
          timeout_sec="120"/>
        <TaskAction name="Detect2"
          action_name="/detect_well_plate"
          command='{"require":"place_safe"}'
          overrides="{explore_result}"
          timeout_sec="180"/>
        <TaskAction name="PickFromRobotContainer"
          action_name="/pick_from_robot_container"
          command='{"use_guide_mode": true}'
          timeout_sec="300"/>
        <TaskAction name="PlaceMachine"
          action_name="/place"
          command='{}'
          overrides="{explore_result}"
          timeout_sec="300"/>
        <JsonService name="HomeEnd"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- ========== pick from robot container then place back into same container ========== -->
  <BehaviorTree ID="MainPickContainerThenPlaceOnRobot">
    <ReactiveSequence name="safe_pick_container_then_place_on_robot">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <TaskAction name="PickFromRobotContainer"
          action_name="/pick_from_robot_container"
          command='{"use_guide_mode": true}'
          timeout_sec="300"/>
        <TaskAction name="PlaceOnRobot"
          action_name="/place_on_robot"
          command='{}'
          timeout_sec="400"/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- ========== pick well plate from robot-side container only ========== -->
  <BehaviorTree ID="MainPickFromRobotContainer">
    <ReactiveSequence name="safe_pick_from_robot_container">
      <SystemHealthy topic="/world_model" timeout_sec="2.0"/>
      <Sequence name="seq">
        <SubTree ID="InitMinimal"/>
        <TaskAction name="PickFromRobotContainer"
          action_name="/pick_from_robot_container"
          command='{"use_guide_mode": true}'
          timeout_sec="300"/>
        <JsonService name="HomeEnd"
          service_name="/joint_command"
          command='{"pose": "home", "speed": 0.3}'/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

</root>
